---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroEyebrow?: string;
  heroDescription?: string;
  heroImage?: ImageMetadata;
  heroOverlay?: 'top' | 'side';
  heroFocus?: string;
}

const {
  title,
  description,
  heroTitle,
  heroEyebrow,
  heroDescription,
  heroImage,
  heroOverlay = 'top',
  heroFocus,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero
    title={heroTitle}
    eyebrow={heroEyebrow}
    description={heroDescription}
    image={heroImage}
    overlay={heroOverlay}
    focus={heroFocus}
  />
  <slot />
</BaseLayout>
