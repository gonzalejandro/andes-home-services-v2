---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CardMedia from '../components/CardMedia.astro';
import { galleryImages } from '../data/gallery';
import { getInstagramFeedWithRefresh } from '../lib/instagram-cache';
import { getVideos } from '../lib/instagram';
import { site } from '../config/site';

const instagramVideos = getVideos(await getInstagramFeedWithRefresh());
---

<PageLayout
  title={`Gallery | ${site.name}`}
  description="Photos of professional stump grinding equipment and projects across Metro Detroit."
  heroTitle="Project gallery"
  heroEyebrow="Our Work"
  heroDescription="Professional equipment and real stump grinding work."
>
  <Section reveal>
    <Container>
      <SectionHeading
        eyebrow="Gallery"
        title="Our work"
        subtitle="Equipment and projects from across Metro Detroit."
      />
      <div class="grid gap-[1.5rem] sm:grid-cols-2">
        {
          galleryImages.map((image) => (
            <Card media>
              <CardMedia slot="media">
                <Image
                  src={image.src}
                  alt={image.alt}
                  class="h-full w-full animate-hero-zoom object-cover"
                  loading="lazy"
                />
              </CardMedia>
              <p class="text-[0.93rem] font-medium text-muted">{image.caption}</p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {
    instagramVideos.length > 0 && (
      <Section tone="alt" reveal>
        <Container>
          <SectionHeading
            eyebrow="Instagram"
            title="From Instagram"
            subtitle="Recent stump grinding videos from our Instagram."
          />
          <div class="grid gap-[1.5rem] sm:grid-cols-2 lg:grid-cols-3">
            {instagramVideos.map((video) => (
              <Card media>
                <div slot="media" class="aspect-[9/16] overflow-hidden bg-brand-900">
                  <video
                    src={video.mediaUrl}
                    poster={video.thumbnailUrl}
                    class="h-full w-full object-cover"
                    controls
                    playsinline
                    preload="none"
                  />
                </div>
                <div class="flex items-center justify-between gap-[0.75rem] text-[0.85rem]">
                  {video.caption && (
                    <span class="line-clamp-2 font-medium text-muted">{video.caption}</span>
                  )}
                  <a
                    href={video.permalink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 font-semibold text-brand-900 underline underline-offset-2 hover:text-accent"
                  >
                    View on Instagram
                  </a>
                </div>
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }
</PageLayout>
