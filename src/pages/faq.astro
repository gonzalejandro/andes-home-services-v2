---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../config/site';
import { faqItems } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<PageLayout
  title={`FAQ | ${site.name}`}
  description="Frequently asked questions about stump grinding, pricing, timing, wood chips, and service areas in Metro Detroit."
  heroTitle="Frequently asked questions"
  heroEyebrow="FAQ"
  heroDescription="Everything you need to know before we show up. Don't see your question? Call or text us."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <Section reveal class="mesh-bg bg-cream">
    <Container class="relative z-[1]">
      <FAQ />
    </Container>
  </Section>
</PageLayout>
