---
import homeHelp1 from '../assets/home-help.webp';
import homeHelp2 from '../assets/home-help-2.webp';
import homeHelp3 from '../assets/home-help-3.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceHoverCards from '../components/ServiceHoverCards.astro';
import AreasCard from '../components/AreasCard.astro';
import Carousel from '../components/Carousel.astro';
import CheckList from '../components/CheckList.astro';
import ContactList from '../components/ContactList.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import { site } from '../config/site';
import { services } from '../data/services';

const cards = services.map((service) => ({
  title: service.title,
  description: service.description,
  clip: service.clip,
  clipAlt: service.clipAlt,
  panel: service.panel,
  cropTop: 'cropTop' in service ? service.cropTop : false,
  // The mockup points every card at the services overview; the detail pages
  // are a better destination now that they exist.
  href: `/services/${service.slug}`,
}));

const carouselImages = [
  { src: homeHelp1, alt: 'Stump grinder working at the base of a tree' },
  { src: homeHelp2, alt: 'Operator grinding a stump next to a driveway' },
  { src: homeHelp3, alt: 'Stump grinder parked beside a brick house' },
];
---

<BaseLayout>
  <Hero
    eyebrow="Serving Metro Detroit — Macomb, Oakland & Wayne Counties"
    title="Hard on stumps.<br>Easy on you."
    lead="Reliable stump grinding for homeowners, landscapers, and tree companies throughout Metro Detroit."
    {/* Not "Licensed": stump grinding needs no state license in Michigan. */}
    badges={['Fully Insured', 'Same-Week Service', '500+ Stumps Removed']}
  />

  {/* Sits above the areas section so its gradient fades in behind this one. */}
  <section class="reveal relative z-[1] pb-[2rem] pt-[7rem]">
    <Container>
      <SectionHeading eyebrow="What We Do" title="Our services" class="mb-[4rem]" />
      <ServiceHoverCards cards={cards} />
      <div class="mt-[2.5rem] flex justify-center lg:justify-end">
        <Button href="/services" variant="outline" arrow>More about what we do</Button>
      </div>
    </Container>
  </section>

  {/* Pulled up under the services section so the mesh gradient fades in
      gradually instead of starting at a hard edge. */}
  <section id="areas" class="mesh-bg reveal -mt-[8rem] bg-cream pb-[3rem] pt-[12rem]">
    <Container class="relative z-[1]">
      <AreasCard counties={site.location.areaServed} />
    </Container>
  </section>

  <Section reveal class="pt-[4rem]">
    <Container class="grid items-center gap-[3rem] lg:grid-cols-2">
      <Carousel images={carouselImages} label="Photos of our stump grinding work" />
      <div>
        <Eyebrow>Why Choose Us?</Eyebrow>
        <h2 class="text-display-md">Fast and affordable stump grinding</h2>
        <p class="mt-[1rem] text-muted">
          From a single stump to a full property cleanup, we make removal fast, safe, and
          hassle-free.
        </p>
        <CheckList items={['Free quotes', 'Fully insured', 'Affordable pricing']} circles />
        <Button href="/about" variant="outline" size="lg">More about us</Button>
      </div>
    </Container>
  </Section>

  <Section tone="dark" reveal id="get-quote">
    <Container class="grid items-center gap-[3rem] lg:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-display-xl text-white">Let's work together</h2>
        <ContactList tone="dark" />
      </div>
      <ContactForm client:load onDark />
    </Container>
  </Section>

  <Section id="reviews" reveal class="border-t border-brand-100 bg-brand-50">
    <Container>
      <ReviewsBlock />
    </Container>
  </Section>
</BaseLayout>
