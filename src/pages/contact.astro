---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import ContactList from '../components/ContactList.astro';
import ContactForm from '../components/ContactForm';
import { site } from '../config/site';
---

{/* No photo banner on this page, so the overlaid header switches to dark text. */}
<BaseLayout
  title={`Contact | ${site.name}`}
  description={`Request a free stump grinding estimate from ${site.name}. Call ${site.phone} or send us a message.`}
  headerVariant="dark"
>
  <Section pageTop reveal>
    <Container class="grid items-center gap-[3rem] lg:grid-cols-[1fr_1.2fr]">
      <div>
        <h1 class="text-display-xl">Let's work together</h1>
        <ContactList />
      </div>
      <div>
        <ContactForm client:load />
        <p class="mt-[1rem] text-center text-[0.8rem] text-muted">
          Outside Macomb, Oakland, or Wayne County? We can still help — a travel fee may apply.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
