---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import CTABanner from '../components/CTABanner.astro';
import { site } from '../config/site';
---

<PageLayout
  title={`Reviews | ${site.name}`}
  description={`Read Google reviews for ${site.name} — professional stump grinding in Metro Detroit.`}
  heroTitle="Google reviews"
  heroEyebrow="Reviews"
  heroDescription="What customers are saying about our stump grinding services."
>
  <Section reveal class="bg-brand-50">
    <Container>
      <ReviewsBlock showHeading={false} />
    </Container>
  </Section>

  <CTABanner
    title="Ready to join our happy customers?"
    description="Request a free estimate today — no obligation."
    href="/contact"
  />
</PageLayout>
