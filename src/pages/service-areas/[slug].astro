---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import CheckList from '../../components/CheckList.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { site } from '../../config/site';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
---

<PageLayout
  title={`Stump Grinding in ${area.name} | ${site.name}`}
  description={`${site.name} provides professional stump grinding in ${area.name}, Michigan. Free estimates, fully insured.`}
  heroTitle={`Stump grinding in ${area.name}`}
  heroEyebrow="Service Area"
  heroDescription={`Professional stump removal serving ${area.county} County and surrounding communities.`}
>
  <Section reveal>
    <Container class="mx-auto grid max-w-[800px] gap-[2rem]">
      <p class="text-muted">{area.description}</p>
      <Card>
        <h3 class="mb-[0.4rem]">What we offer in {area.name}</h3>
        <CheckList items={area.highlights} />
      </Card>
      <p class="text-[0.85rem] text-muted">
        Outside {area.name}? We may still be able to help — a travel fee may apply for locations
        beyond our standard service area.
      </p>
    </Container>
  </Section>
</PageLayout>
