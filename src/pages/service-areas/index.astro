---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CountyCard from '../../components/CountyCard.astro';
import AreasCard from '../../components/AreasCard.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { site } from '../../config/site';
---

<PageLayout
  title={`Service Areas | ${site.name}`}
  description={`Stump grinding in Macomb, Oakland, and Wayne counties. Based in ${site.location.city}, serving Metro Detroit.`}
  heroTitle="Service areas"
  heroEyebrow="Where We Work"
  heroDescription={`Proudly serving Metro Detroit from ${site.location.city}.`}
>
  <Section class="mesh-bg bg-cream" reveal>
    <Container class="relative z-[1]">
      <AreasCard counties={site.location.areaServed} />
    </Container>
  </Section>

  <Section reveal>
    <Container>
      <SectionHeading
        eyebrow="Counties"
        title="Counties we serve"
        subtitle="Macomb, Oakland, and Wayne counties — and surrounding communities."
      />
      <div class="grid gap-[1.5rem] sm:grid-cols-2 lg:grid-cols-3">
        {
          serviceAreas.map((area) => (
            <CountyCard
              name={area.name}
              href={`/service-areas/${area.slug}`}
              description={area.description.slice(0, 160) + '…'}
            />
          ))
        }
      </div>
      <p class="mt-[2rem] text-center text-[0.93rem] text-muted">
        Outside our standard service area? We may still be able to help — a travel fee may apply for
        locations beyond Macomb, Oakland, and Wayne counties.
      </p>
    </Container>
  </Section>
</PageLayout>
