---
import { site } from '../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = [
  { label: 'Facebook', href: site.social.facebook, icon: 'facebook' as const },
  { label: 'Instagram', href: site.social.instagram, icon: 'instagram' as const },
  { label: 'Google Business Profile', href: site.social.google, icon: 'google' as const },
].filter((link) => link.href);

// Brand-coloured circles, per the mockup.
const chrome = {
  facebook: 'bg-[#1877f2] text-white',
  instagram:
    'bg-[radial-gradient(circle_at_30%_107%,#fdf497_0%,#fdf497_5%,#fd5949_45%,#d6249f_60%,#285aeb_90%)] text-white',
  google: 'bg-white',
};
---

{
  links.length > 0 && (
    <div class:list={['flex gap-[0.9rem]', className]}>
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class:list={[
            'grid h-[36px] w-[36px] place-items-center rounded-full transition-[transform,box-shadow] duration-200 hover:-translate-y-[2px] hover:shadow-[0_6px_14px_rgb(0_0_0/0.25)]',
            chrome[link.icon],
          ]}
        >
          {link.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z" />
            </svg>
          )}
          {link.icon === 'instagram' && (
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          )}
          {link.icon === 'google' && (
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                fill="#4285F4"
                d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4c-.2 1.2-.9 2.3-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4z"
              />
              <path
                fill="#34A853"
                d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6C4.8 19.8 8.1 22 12 22z"
              />
              <path
                fill="#FBBC05"
                d="M6.4 13.9c-.2-.6-.3-1.2-.3-1.9s.1-1.3.3-1.9V7.5H3.1C2.4 8.9 2 10.4 2 12s.4 3.1 1.1 4.5l3.3-2.6z"
              />
              <path
                fill="#EA4335"
                d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9C17 3 14.7 2 12 2 8.1 2 4.8 4.2 3.1 7.5l3.3 2.6C7.2 7.8 9.4 6 12 6z"
              />
            </svg>
          )}
        </a>
      ))}
    </div>
  )
}
