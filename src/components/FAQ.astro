---
import { faqSections } from '../data/faq';
---

<div>
  {
    faqSections.map((section, sectionIndex) => (
      <div class:list={['mx-auto max-w-[800px] text-brand-900', sectionIndex > 0 && 'mt-[3rem]']}>
        <h2 class="mb-[1.25rem] text-center text-display-sm">{section.title}</h2>
        <div class="grid gap-[0.75rem]">
          {section.items.map((item, itemIndex) => (
            <details
              open={sectionIndex === 0 && itemIndex === 0}
              class="group rounded-theme border border-white/55 bg-white/55 px-[1.4rem] py-[1.1rem]"
            >
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-[1rem] text-[1.05rem] font-medium text-brand-900 marker:content-none [&::-webkit-details-marker]:hidden"
              >
                <span>{item.question}</span>
                <span
                  class="text-[1.3rem] font-normal text-brand-900 opacity-80 transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-[0.8rem] text-[1rem] text-brand-900 opacity-80">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    ))
  }
</div>
