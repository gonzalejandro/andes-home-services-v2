---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroDefault from '../assets/hero.webp';
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  badges?: readonly string[];
  image?: ImageMetadata;
}

const {
  eyebrow,
  title,
  lead,
  badges = [],
  image = heroDefault,
} = Astro.props;
---

<section
  class="relative flex items-center overflow-hidden bg-brand-900 pb-[4rem] pt-[11rem] font-display text-white sm:min-h-[88vh] sm:pb-[5rem]"
>
  {/* Photo layer, slowly zooming. A real <img> rather than the mockup's CSS
      background so Astro emits a responsive, optimised source set. */}
  <Image
    src={image}
    alt=""
    class="absolute inset-0 h-full w-full animate-hero-zoom object-cover"
    loading="eager"
    fetchpriority="high"
  />

  {/* Light overall tint, plus a darker green fade on the left behind the text. */}
  <div class="absolute inset-0 z-[1] bg-[rgb(21_54_43/0.35)]"></div>
  <div
    class="absolute inset-0 z-[1] bg-[linear-gradient(90deg,rgb(21_54_43/0.92)_0%,rgb(21_54_43/0.7)_28%,rgb(21_54_43/0)_62%)]"
  >
  </div>

  <Container class="relative z-[2]">
    <div class="max-w-[720px]">
      {eyebrow && <Eyebrow tone="light">{eyebrow}</Eyebrow>}
      <h1 class="mb-[1.5rem] text-hero font-semibold text-white" set:html={title} />
      {lead && (
        <p class="mb-[1.75rem] max-w-[50ch] font-sans text-[1.1rem] font-normal opacity-95">
          {lead}
        </p>
      )}
      <div class="mb-[2rem] flex flex-wrap gap-[0.75rem]">
        <Button href="/contact" variant="primary" size="lg">Get my free estimate</Button>
        <Button href="#areas" variant="primary" size="lg">Areas we service</Button>
      </div>
      {badges.length > 0 && (
        <ul class="flex flex-wrap gap-[1.25rem] text-[0.85rem] font-medium opacity-90">
          {badges.map((badge) => (
            <li>
              <span aria-hidden="true">✔ </span>
              {badge}
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>
