---
import Stars from './Stars.astro';

interface Props {
  rating: number;
}

const { rating } = Astro.props;

// Gold shield showing the overall rating.
const SHIELD = '[clip-path:polygon(50%_0%,100%_8%,100%_72%,50%_100%,0%_72%,0%_8%)]';
---

<div
  class:list={[
    'bg-[#c9a033] p-[2px] [filter:drop-shadow(0_2px_6px_rgb(92_72_16/0.22))]',
    SHIELD,
  ]}
>
  <div
    class:list={[
      'min-w-[6rem] bg-gradient-to-b from-[#fff8e7] to-[#f5e6b8] px-[1.35rem] pb-[0.5rem] pt-[0.7rem] text-center',
      SHIELD,
    ]}
  >
    <p class="font-display text-[1.6rem] font-bold leading-none text-brand-900">
      {rating.toFixed(1)}
    </p>
    <div class="mt-[0.25rem] flex justify-center">
      <Stars rating={rating} size="sm" />
    </div>
  </div>
</div>
