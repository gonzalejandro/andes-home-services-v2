---
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  cta?: string;
}

const { title, description, href, cta = 'Request a Free Estimate' } = Astro.props;
---

<section class="bg-brand-900 text-white">
  <Container class="py-[3.25rem] text-center sm:py-[4.5rem]">
    <h2 class="mb-[0.75rem] text-display-md text-white">{title}</h2>
    <p class="mx-auto mb-[1.5rem] max-w-[55ch] text-[0.9rem] opacity-85">{description}</p>
    <Button href={href} variant="light" size="lg">{cta}</Button>
  </Container>
</section>
