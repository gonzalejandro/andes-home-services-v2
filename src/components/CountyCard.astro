---
import Card from './Card.astro';

interface Props {
  name: string;
  href: string;
  description: string;
}

const { name, href, description } = Astro.props;
---

<Card href={href} class="group block">
  <h3 class="mb-[0.4rem]">{name}</h3>
  <p class="text-[0.93rem] text-muted">{description}</p>
  <span class="mt-[1rem] inline-block text-[0.9rem] font-semibold text-brand-900">
    View service area
    <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
      →
    </span>
  </span>
</Card>
