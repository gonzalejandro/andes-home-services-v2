---
import { Image } from 'astro:assets';
import logo from '../assets/andes-stump-grinding.png';
import { site, navLinks } from '../config/site';
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  /** `dark` for pages with no photo banner behind the overlaid header. */
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const dark = variant === 'dark';
const currentPath = Astro.url.pathname;
---

<!-- Overlaid on the hero; the border spans the full width, not the container. -->
<header
  class:list={[
    'absolute inset-x-0 top-0 z-[100] border-b-[0.5px]',
    dark ? 'border-brand-900/25 text-brand-900' : 'border-white/35 text-white',
  ]}
>
  <Container
    class="flex flex-wrap items-center justify-center gap-x-[2rem] gap-y-[0.75rem] py-[1.1rem] xl:flex-nowrap xl:justify-between"
  >
    <a href="/" class="flex shrink-0 items-center gap-[0.6rem]">
      {/* The logo is dark green on transparent and squarely padded, so it gets
          inverted for the dark hero and pulled tight with negative margins. */}
      <Image
        src={logo}
        alt=""
        class:list={['-my-[12px] h-[64px] w-auto', !dark && 'brightness-0 invert']}
      />
      <span class="font-display text-[1.1rem] font-semibold tracking-[0.01em]">{site.name}</span>
    </a>

    <nav
      class="flex flex-wrap justify-center gap-[1.1rem] text-[0.85rem] font-medium sm:gap-[1.75rem] sm:text-[0.9rem]"
      aria-label="Main navigation"
    >
      {
        navLinks.map((link) => {
          const isActive =
            link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'relative transition-colors',
                dark ? 'hover:text-accent' : 'hover:text-brand-900',
                // Small dot before the current page's link.
                isActive &&
                  "before:absolute before:left-[-0.9rem] before:top-1/2 before:h-[5px] before:w-[5px] before:-translate-y-1/2 before:rounded-full before:bg-current before:content-[''] max-sm:before:hidden",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <Button href={`tel:${site.phoneTel}`} variant={dark ? 'ghostDark' : 'ghost'}>
      Need a quote? Call or text {site.phone}
    </Button>
  </Container>
</header>
