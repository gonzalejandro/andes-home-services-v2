---
import { site } from '../config/site';
---

<a
  href={`tel:${site.phoneTel}`}
  class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-full border-[0.5px] border-brand-900 bg-brand-900 px-[1.2rem] py-[0.6rem] text-[0.85rem] font-medium text-white shadow-lift transition-colors duration-200 hover:bg-brand-800 sm:bottom-6 sm:right-6"
  aria-label={`Call us at ${site.phone}`}
>
  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
    <path
      d="M6.6 10.8c1 2 2.6 3.6 4.6 4.6l1.5-1.5c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V18c0 .6-.4 1-1 1-8.3 0-15-6.7-15-15 0-.6.4-1 1-1h2.7c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1l-1.7 1.3z"
    />
  </svg>
  <span class="hidden sm:inline">Call Us</span>
</a>
