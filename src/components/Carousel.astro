---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * Auto-playing crossfade: images stacked, each fading in and out on a 7.5s
 * cycle (3 images x 2.5s), offset with negative animation delays.
 */
interface Props {
  images: readonly { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { images, label } = Astro.props;

const delays = ['[animation-delay:0s]', '[animation-delay:-5s]', '[animation-delay:-2.5s]'];
---

<div
  class="relative aspect-[4/3] w-full overflow-hidden rounded-theme shadow-soft transition-[transform,box-shadow] duration-200 hover:-translate-y-[4px] hover:shadow-lift"
  role="group"
  aria-label={label}
>
  {
    images.map((image, index) => (
      <Image
        src={image.src}
        alt={image.alt}
        class:list={[
          'absolute inset-0 h-full w-full animate-carousel-fade object-cover object-[center_58%] opacity-0',
          delays[index % delays.length],
        ]}
        loading="lazy"
      />
    ))
  }
</div>
